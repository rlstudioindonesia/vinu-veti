// Cloudflare (Workers & Pages) hosting of the web / iPhone version: serves the static build, plus the
// online content from R2 (worker/index.js). Setup of the bucket and the admin accounts: docs/R2.md.
// Build command: npm run build:web · Deploy command: npx wrangler deploy · Root directory: / · Previews: npx wrangler preview
{
  "name": "vinu-veti",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./web-app/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only content and admin requests run the Worker; the app itself stays plain static files
    "run_worker_first": ["/cdn/*", "/api/*"]
  },
  "r2_buckets": [{ "binding": "CONTENT", "bucket_name": "vinu-veti-konten" }],
  "vars": {
    // Old content location: files not yet in R2 are copied from here once (no re-upload needed)
    "LEGACY_CONTENT_URL": "https://ctowesyemrjkrjaitfft.supabase.co/storage/v1/object/public/vinu-veti/"
  },
  "previews": {}
}
