# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# VITE_CONTENT_URL: (opsional) alamat folder paket konten online, berisi manifest.json + models/ + audio/.
# Contoh: https://username.github.io/vinu-veti-konten/
# Saat online, aplikasi mengunduh konten yang lebih baru sekali lalu menyimpannya untuk mode offline.
# Taruh di web-app/.env lalu jalankan `npm run build` di folder web-app.
# VITE_CONTENT_URL=
