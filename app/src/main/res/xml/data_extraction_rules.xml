<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12+ backup rules.
   Cloud backup (Google Drive) allows only 25 MB per app: the downloaded 3D models, voices and the
   WebView content database (hundreds of MB) would make every backup fail. They are left out: after a
   restore the app downloads them again (or uses the copies inside the APK).
   Device-to-device transfer has no size limit: everything is copied, so a new phone works offline
   straight away.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="ar_models/" />
        <exclude domain="file" path="ar_audio/" />
        <exclude domain="root" path="app_webview/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
        <include domain="root" path="app_webview/" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
