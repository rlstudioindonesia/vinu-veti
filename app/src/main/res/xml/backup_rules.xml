<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 11 and older (see data_extraction_rules.xml for Android 12+): the
   downloaded 3D models, voices and the WebView content database exceed the 25 MB backup limit, so
   they are left out and downloaded again after a restore.
-->
<full-backup-content>
    <exclude domain="file" path="ar_models/" />
    <exclude domain="file" path="ar_audio/" />
    <exclude domain="root" path="app_webview/" />
</full-backup-content>
